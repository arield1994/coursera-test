# --- Main odds feed -------------------------------------------------------
# Without a key the site runs on a generated demo board and says so in the
# header. Get one at https://the-odds-api.com
ODDS_API_KEY=

# How long a fetched odds payload is reused before hitting the provider again.
# Every upstream request costs quota, so raise this if you are burning credits.
ODDS_CACHE_TTL_MS=30000


# --- Your own lines: pushing ---------------------------------------------
# Shared secret for POST /api/ingest. Send it as 'Authorization: Bearer <token>'.
# Leave unset in development and the endpoint is open; in production an unset
# token disables ingest entirely rather than leaving an unauthenticated write
# path into the scanner.
INGEST_TOKEN=


# --- Your own lines: pulling ---------------------------------------------
# A JSON *array* of private endpoints to poll. Build and test the mapping on
# the Sources page (Pull from an API), which previews it in-browser against a
# pasted sample response, then paste the result here.
#
# CUSTOM_SOURCES='[{"key":"mybookie","title":"My Bookie","url":"https://api.example.internal/odds","headers":{"Authorization":"Bearer ..."},"sharp":false,"ttlSeconds":60,"mapping":{"lines":"data.events","home":"fixture.home","away":"fixture.away","commenceTime":"fixture.starts","market":"type","outcomes":"selections","outcomeName":"label","american":"price_us"}}]'
CUSTOM_SOURCES=

# How long a pull source's response is reused before polling it again.
CUSTOM_SOURCE_TTL_MS=20000
